{
  "manifest_version": 3,
  "name": "InstaGrab - 1-Click Media Downloader",
  "version": "1.0.0",
  "description": "Download Pinterest videos and images directly with 1-click via InstaGrab Desktop Engine.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "InstaGrab Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.pinterest.com/*",
    "http://127.0.0.1:18765/*",
    "http://localhost:18765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
